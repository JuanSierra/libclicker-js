{
  "name": "libclicker",
  "version": "0.3.4",
  "description": "JS library for clicker games",
  "keywords": [
    "games",
    "clicker",
    "idle",
    "incremental",
    "generator"
  ],
  "main": "dist/libclicker.js",
  "dependencies": {
    "handlebars": "^4.7.7",
    "minimist": "^1.2.8",
    "set-value": "^4.1.0"
  },
  "type": "module",
  "devDependencies": {
    "jest": "^30.4.2",
    "rollup": "^4.62.4",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "test": "jest",
    "doc": "jsdoc -c jsdoc.conf.json",
    "uglify-module": "uglifyjs dist/libclicker.mjs -o dist/libclicker.min.mjs",
    "uglify": "uglifyjs dist/libclicker.js -o dist/libclicker.min.js",
    "build": "rollup -c && npm run uglify && npm run uglify-module"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanSierra/libclicker-js.git"
  },
  "author": "Juan Sierra",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/JuanSierra/libclicker-js/issues"
  },
  "homepage": "https://github.com/JuanSierra/libclicker-js#readme"
}
